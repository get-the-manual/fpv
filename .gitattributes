# Normalize line endings: LF in the repository, native in the working copy
* text=auto

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.sln text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.pdf binary
*.zip binary
*.stl binary
*.3mf binary
*.glb binary
